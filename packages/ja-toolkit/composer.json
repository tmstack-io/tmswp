{
  "name": "tmswp/ja-toolkit",
  "description": "TMStack WordPress Framework - Japanese Toolkit",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3",
    "ext-mbstring": "*",
    "tmswp/core": "^0.9"
  },
  "require-dev": {
    "tmswp/testing": "^0.9"
  },
  "autoload": {
    "psr-4": {
      "TMSWP\\JaToolkit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TMSWP\\JaToolkit\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.9.x-dev"
    }
  },
  "minimum-stability": "stable",
  "config": {
    "sort-packages": true
  }
}
