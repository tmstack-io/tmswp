#!/usr/bin/env php
<?php

declare(strict_types=1);

if ($argc < 2) {
    fwrite(STDERR, "Usage: php bin/tms-check <actions-dir> [<template-root> ...]\n");
    exit(2);
}

$actionsDir = rtrim($argv[1], DIRECTORY_SEPARATOR);

if (!is_dir($actionsDir)) {
    fwrite(STDERR, "actions directory does not exist: {$actionsDir}\n");
    exit(2);
}

$templateRoots = array_slice($argv, 2);

if ($templateRoots === []) {
    $parent = dirname($actionsDir);
    $templateRoots = [$parent];
}

$violations = [];
$iterator = new RecursiveIteratorIterator(
    new RecursiveDirectoryIterator($actionsDir, FilesystemIterator::SKIP_DOTS)
);

foreach ($iterator as $fileInfo) {
    if (!$fileInfo instanceof SplFileInfo || $fileInfo->getExtension() !== 'php') {
        continue;
    }

    $path = $fileInfo->getPathname();
    $relative = ltrim(substr($path, strlen($actionsDir)), DIRECTORY_SEPARATOR);
    $matched = false;

    foreach ($templateRoots as $templateRoot) {
        $templatePath = rtrim($templateRoot, DIRECTORY_SEPARATOR) . DIRECTORY_SEPARATOR . $relative;

        if (is_file($templatePath)) {
            $matched = true;
            break;
        }
    }

    if (!$matched) {
        $violations[] = "{$path}:1: orphan actions file has no matching template";
    }
}

foreach ($violations as $violation) {
    fwrite(STDERR, $violation . PHP_EOL);
}

exit($violations === [] ? 0 : 1);
