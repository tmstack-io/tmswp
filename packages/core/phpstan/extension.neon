services:
    -
        class: TMSWP\Core\PHPStan\KernelResetCallChecker
    -
        class: TMSWP\Core\PHPStan\MetaSchemaReflector
    -
        class: TMSWP\Core\PHPStan\MetaBagGetterReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
    -
        class: TMSWP\Core\PHPStan\OptionGroupGetterReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension

rules:
    - TMSWP\Core\PHPStan\KernelResetMethodCallableOutsideTestRule
    - TMSWP\Core\PHPStan\KernelResetOutsideTestRule
    - TMSWP\Core\PHPStan\KernelResetStaticCallableOutsideTestRule
    - TMSWP\Core\PHPStan\MetaKeyOwnershipRule
